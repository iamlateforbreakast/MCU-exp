# Containerfile to build a container image for RTL8720DN (AI Thinker BW16) development
# using the Realtek AmebaD SDK, bypassing the Arduino framework for low-level access
# to the Cortex-M33 (High Power/KM4) and Cortex-M23 (Low Power/KM0) cores.
# Intended for use with podman (see compose.yaml, which relies on userns_mode: keep-id
# to map the host user's UID/GID into the container).
FROM ubuntu:24.04

LABEL com.github.containers.toolbox="true" \
      com.github.debarshiray.toolbox="true"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get -y upgrade && \
    apt-get install -y \
        binutils-arm-none-eabi \
        build-essential \
        gcc-arm-none-eabi \
        gdb-multiarch \
        git \
        libncurses-dev \
        libssl-dev \
        libusb-1.0-0 \
        libusb-1.0-0-dev \
        python3 \
        python3-pip \
        python3-venv \
        sudo \
        udev \
        unzip \
        vim \
        wget && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Username and UID/GID are configurable so the container's user can match the
# host user podman maps in via userns_mode: keep-id.
ARG USERNAME=builder
ARG USER_UID=1000
ARG USER_GID=${USER_UID}

# ubuntu:24.04 ships a stock "ubuntu" user/group at 1000:1000; remove it so the
# configurable UID/GID below don't collide with it.
# Added to sudo and dialout groups (dialout for serial/USB flashing access)
RUN userdel -r ubuntu && \
    groupadd -g ${USER_GID} ${USERNAME} && \
    useradd -u ${USER_UID} -g ${USER_GID} -c "RTL8720DN Developer" \
            -G sudo,dialout -d "/home/${USERNAME}" --create-home "${USERNAME}" && \
    export PS1="\[\033[01;34m\](podman) \[\033[00m\]\u@\h:\w\$ " >> /home/${USERNAME}/.bashrc

# Allow sudo without password
RUN echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

RUN touch /etc/localtime
RUN echo VARIANT_ID=container >> /etc/os-release

USER ${USERNAME}
WORKDIR /home/${USERNAME}

# arm-none-eabi-gcc lands flat in /usr/bin via apt, so that's the toolchain dir
# the Realtek SDK's build scripts expect.
ENV RTK_TOOLCHAIN_DIR=/usr/bin

# Fetch the Realtek AmebaD SDK (shallow clone; it's a large monorepo) and the
# BW16 flash tool
RUN git clone --depth 1 https://github.com/Ameba-AIoT/ameba-rtos.git /home/${USERNAME}/ameba-rtos && \
    git clone --depth 1 https://github.com/jojoling/ameba_bw16_autoflash.git /home/${USERNAME}/ameba_bw16_autoflash

CMD ["/bin/bash"]
