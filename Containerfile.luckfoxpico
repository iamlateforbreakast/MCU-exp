# Containerfile to build a container image for Luckfox Pico (RV1103/RV1106) development.
# Based on the vendor's official luckfox_pico SDK image. Unlike the bare-metal MCU
# containers in this repo, the Buildroot-based SDK is a multi-GB tree that the vendor
# expects to be cloned on the host and bind-mounted at runtime (see compose.yaml)
# rather than baked into the image - see workspace/Luckfoxpico/luckfoxpic.md.
# Intended for use with podman (see compose.yaml, which relies on userns_mode: keep-id
# to map the host user's UID/GID into the container).
FROM docker.io/luckfoxtech/luckfox_pico:1.0

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get -y install sudo git vim && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Username and UID/GID are configurable so the container's user can match the
# host user podman maps in via userns_mode: keep-id.
ARG USERNAME=builder
ARG USER_UID=1000
ARG USER_GID=${USER_UID}

# The vendor image's own user/group layout at the target UID/GID is unknown, so
# remove whatever occupies it first instead of assuming a specific name (unlike
# the other Containerfiles here, which know they're deleting ubuntu:24.04's "ubuntu").
RUN existing_user="$(getent passwd ${USER_UID} | cut -d: -f1)"; \
    if [ -n "$existing_user" ]; then userdel -r "$existing_user" 2>/dev/null || userdel "$existing_user" || true; fi; \
    existing_group="$(getent group ${USER_GID} | cut -d: -f1)"; \
    if [ -n "$existing_group" ]; then groupdel "$existing_group" 2>/dev/null || true; fi; \
    groupadd -g ${USER_GID} ${USERNAME} && \
    useradd -u ${USER_UID} -g ${USER_GID} -c "Luckfox Pico Developer" \
            -G sudo -d "/home/${USERNAME}" --create-home "${USERNAME}" && \
    export PS1="\[\033[01;34m\](podman) \[\033[00m\]\u@\h:\w\$ " >> /home/${USERNAME}/.bashrc

# Allow sudo without password
RUN echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

RUN touch /etc/localtime
RUN echo VARIANT_ID=container >> /etc/os-release

USER ${USERNAME}
WORKDIR /home/${USERNAME}

CMD ["/bin/bash"]
