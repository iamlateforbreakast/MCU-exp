# Dockerfile to build a container image for ESP32-C3 development using ESP-IDF
# Intended for use with podman (see compose.yaml, which relies on userns_mode: keep-id
# to map the host user's UID/GID into the container).
FROM ubuntu:24.04

LABEL com.github.containers.toolbox="true" \
      com.github.debarshiray.toolbox="true"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get -y upgrade && \
    apt-get install -y \
        bison \
        build-essential \
        ccache \
        cmake \
        curl \
        flex \
        git \
        gperf \
        gdb \
        libffi-dev \
        libssl-dev \
        libusb-1.0-0 \
        libusb-1.0-0-dev \
        ninja-build \
        python3 \
        python3-pip \
        python3-venv \
        sudo \
        udev \
        unzip \
        wget && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Username and UID/GID are configurable so the container's user can match the
# host user podman maps in via userns_mode: keep-id.
ARG USERNAME=thomas
ARG USER_UID=1000
ARG USER_GID=${USER_UID}

# Added to sudo and dialout groups (dialout for serial/USB flashing access)
RUN groupadd -g ${USER_GID} ${USERNAME} && \
    useradd -u ${USER_UID} -g ${USER_GID} -c "ESP32 Developer" \
            -G sudo,dialout -d "/home/${USERNAME}" --create-home "${USERNAME}" && \
    export PS1="\[\033[01;34m\](podman) \[\033[00m\]\u@\h:\w\$ " >> /home/${USERNAME}/.bashrc

# Allow sudo without password
RUN echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

RUN touch /etc/localtime
RUN echo VARIANT_ID=container >> /etc/os-release

USER ${USERNAME}
WORKDIR /home/${USERNAME}

ENV IDF_TOOLS_PATH=/home/${USERNAME}/.espressif

# Fetch ESP-IDF and install the toolchain/tools scoped to the ESP32-C3 target
RUN git clone -b v5.3.1 --recursive https://github.com/espressif/esp-idf.git /home/${USERNAME}/esp-idf && \
    /home/${USERNAME}/esp-idf/install.sh esp32c3

RUN echo ". /home/${USERNAME}/esp-idf/export.sh > /dev/null 2>&1" >> /home/${USERNAME}/.bashrc

CMD ["/bin/bash"]
