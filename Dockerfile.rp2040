# Dockerfile to build a container image for RP2040 (Raspberry Pi Pico) development
# using the official Pico SDK toolchain.
# Intended for use with podman (see compose.yaml, which relies on userns_mode: keep-id
# to map the host user's UID/GID into the container).
FROM ubuntu:24.04

LABEL com.github.containers.toolbox="true" \
      com.github.debarshiray.toolbox="true"

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && \
    apt-get -y upgrade && \
    apt-get install -y \
        build-essential \
        cmake \
        gcc-arm-none-eabi \
        gdb-multiarch \
        git \
        libnewlib-arm-none-eabi \
        libstdc++-arm-none-eabi-newlib \
        libusb-1.0-0 \
        libusb-1.0-0-dev \
        ninja-build \
        pkg-config \
        python3 \
        sudo \
        udev \
        vim \
        wget && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Username and UID/GID are configurable so the container's user can match the
# host user podman maps in via userns_mode: keep-id.
ARG USERNAME=builder
ARG USER_UID=1000
ARG USER_GID=${USER_UID}

# ubuntu:24.04 ships a stock "ubuntu" user/group at 1000:1000; remove it so the
# configurable UID/GID below don't collide with it.
# Added to sudo and dialout groups (dialout for serial/USB flashing access)
RUN userdel -r ubuntu && \
    groupadd -g ${USER_GID} ${USERNAME} && \
    useradd -u ${USER_UID} -g ${USER_GID} -c "RP2040 Developer" \
            -G sudo,dialout -d "/home/${USERNAME}" --create-home "${USERNAME}" && \
    export PS1="\[\033[01;34m\](podman) \[\033[00m\]\u@\h:\w\$ " >> /home/${USERNAME}/.bashrc

# Allow sudo without password
RUN echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

RUN touch /etc/localtime
RUN echo VARIANT_ID=container >> /etc/os-release

USER ${USERNAME}
WORKDIR /home/${USERNAME}

ENV PICO_SDK_PATH=/home/${USERNAME}/pico-sdk

# Fetch the Pico SDK (and its submodules, e.g. tinyusb) for the RP2040
RUN git clone --recursive https://github.com/raspberrypi/pico-sdk.git ${PICO_SDK_PATH}

ENV FREERTOS_KERNEL_PATH=/home/${USERNAME}/FreeRTOS-Kernel

# Fetch the FreeRTOS kernel, including its RP2040 SMP port
# (portable/ThirdParty/GCC/RP2040), for the FreeRTOS example.
RUN git clone https://github.com/FreeRTOS/FreeRTOS-Kernel.git ${FREERTOS_KERNEL_PATH}

CMD ["/bin/bash"]
