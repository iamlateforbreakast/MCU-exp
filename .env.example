# Copy to .env and adjust to override defaults used by compose.yaml.
# Applies to the esp32c3-dev/rp2040-dev/rtl8720dn-dev/luckfoxpico-dev/aim62-dev services.

# Username created inside the container, and the podman user: it runs as.
USERNAME=builder

# UID/GID for that user. Should match your host user so that podman's
# userns_mode: keep-id mapping lines up cleanly with file ownership.
USER_UID=1000
USER_GID=1000

# Each MCU container mounts only its own workspace subfolder to
# /home/$USERNAME/workspace, not the whole workspace/ tree. Override these to
# relocate a given MCU's project files.
ESP32C3_WORKSPACE_DIR=./workspace/ESP32-C3
RP2040_WORKSPACE_DIR=./workspace/RPI2040
RTL8720DN_WORKSPACE_DIR=./workspace/RTL8720DN
LUCKFOXPICO_WORKSPACE_DIR=./workspace/Luckfoxpico
AIM62_WORKSPACE_DIR=./workspace/AI-MF62-AiThinker

# Each MCU container also mounts a separate firmware output directory to
# /home/$USERNAME/firmware, distinct from the workspace mount above - copy
# compiled binaries/images there so they're easy to find on the host for
# flashing, without digging through build directories inside the container.
ESP32C3_FIRMWARE_DIR=./firmware/ESP32-C3
RP2040_FIRMWARE_DIR=./firmware/RPI2040
RTL8720DN_FIRMWARE_DIR=./firmware/RTL8720DN
LUCKFOXPICO_FIRMWARE_DIR=./firmware/Luckfoxpico
AIM62_FIRMWARE_DIR=./firmware/AI-MF62-AiThinker
