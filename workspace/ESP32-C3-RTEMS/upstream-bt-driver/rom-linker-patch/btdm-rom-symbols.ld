/*
 * NOT a standalone linker script - a fragment to append into the RTEMS
 * esp32c3db BSP's own default linker script (this repo doesn't vendor
 * RTEMS - see ../../ESP32-C3-RTEMS.md), the same "fragment to merge, not
 * full copy" convention as ../bsp-patch/. See ../vendor/README.md's
 * "Linking" and "Blob version pinning" sections for the recon this came
 * from.
 *
 * REGENERATED 2026-08-26 (superseding the original 172-line version from
 * 2026-08-25): the first version was built by nm-ing the closed blob at
 * whatever commit `git clone`'s default branch tip happened to be that
 * day (0a08c4b, 2026-05-25) - newer than the IDF v5.3.1 source this
 * whole port vendors bt.c from. That version skew meant this fragment
 * was itself wrong: too narrow for the *correct*, older, v5.3.1-pinned
 * blob (bfdfe8f851c99ced8316b133b0b15521917ea049, resolved via
 * esp-idf.git's own `.gitmodules` + `git ls-tree v5.3.1`), which turned
 * out to need ~950 real ROM symbols, not ~180 - mostly ROM-resident AES/
 * ECC crypto primitives (BLE Secure Connections pairing), LED/EMI debug
 * hooks, and VHCI/H4TL transport glue that the newer blob commit
 * apparently no longer calls through ROM. See ../vendor/README.md for
 * the full story - this is the second time blob/source version skew
 * caused a "symbol genuinely doesn't exist" false alarm in this port;
 * always re-verify against the exact pinned commit before concluding a
 * symbol is truly unresolvable.
 *
 * These lines are real, fixed ESP32-C3 boot-ROM addresses - PROVIDE()'d
 * symbol names the closed libbtdm_app.a blob (and libphy.a) call/read
 * directly, never implemented in software. Regenerated by:
 *   1. Fetching the real closed blobs at the exact IDF v5.3.1-pinned
 *      commits (libbtdm_app.a @ bfdfe8f851c9..., libphy.a @
 *      06e7625de197...) and running real `riscv-rtems7-nm` against them
 *      (cross-toolchain but same RISC-V ELF target - no issues).
 *   2. Computing their full undefined-symbol needs (1296 names, both
 *      archives combined).
 *   3. Matching each against every real `esp32c3.rom*.ld` file (base +
 *      eco3 + eco7 overlays + esp32c3.rom.api.ld) fetched at the same
 *      v5.3.1 tag - 953 matched, listed below. The remaining ~343 are
 *      resolved by bt.c itself, the freertos-compat shim, cross-
 *      resolution between the two blob archives, or libgcc/newlib at
 *      final executable link time.
 *
 * PROVIDE() (not plain assignment) throughout, even where the real IDF
 * scripts use plain `=`, so this fragment never clobbers a symbol this
 * BSP's own linker script (or another input file) already defines.
 */

PROVIDE ( ets_rom_layout_p = 0x3ff1fffc );
PROVIDE ( ets_delay_us = 0x40000050 );

/* Real ESP-IDF aliases esp_rom_delay_us to the ROM's own ets_delay_us
 * via esp32c3.rom.api.ld's `PROVIDE ( esp_rom_delay_us = ets_delay_us );` */
PROVIDE ( esp_rom_delay_us = ets_delay_us );

/* Memory-mapped register-struct globals bt.c/esp_phy/efuse reference
 * directly (e.g. `extern system_dev_t SYSTEM;`) - not ROM code, real
 * fixed peripheral base addresses from soc.h's DR_REG_*_BASE, so these
 * don't depend on which blob commit is linked. */
PROVIDE ( SYSTEM = 0x600c0000 );
PROVIDE ( TIMERG0 = 0x6001F000 );
PROVIDE ( TIMERG1 = 0x60020000 );
PROVIDE ( EFUSE = 0x60008800 );

/* Referenced directly by vendored bt.c/esp_hw_support C files (not by
 * the blobs, so absent from the blob-undefined-symbol scan above) -
 * same real esp32c3.rom*.ld provenance as everything else here. */
PROVIDE ( btdm_controller_rom_data_init = 0x400008ec );
PROVIDE ( ets_get_cpu_frequency = 0x40000584 );
PROVIDE ( esp_rom_printf = ets_printf );
PROVIDE ( esp_rom_get_cpu_ticks_per_us = ets_get_cpu_frequency );

PROVIDE ( TASK_DESC_LLC = 0x3fcdfa1c );
